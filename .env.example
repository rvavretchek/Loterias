DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0
# EMAIL_* generico so vale se BREVO_SMTP_KEY abaixo ficar com o placeholder (nao preenchido) --
# preenchendo BREVO_SMTP_USER/BREVO_SMTP_KEY com a credencial real do Brevo, o settings troca
# sozinho pro backend SMTP (nao precisa mudar EMAIL_BACKEND na mao). Ate la, tudo cai no console
# (e-mail so aparece no terminal onde o runserver esta rodando, nunca chega de verdade).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Lotérias <noreply@loterias.com>
OPERATOR_ALERT_EMAIL=boss@example.com
PASSWORD_PEPPER=change-me-in-production
# Brevo (SMTP relay) -- pegue o login e a chave SMTP em app.brevo.com > SMTP & API > SMTP.
# BREVO_FROM_EMAIL precisa ser um remetente verificado na conta Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_TLS=True
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=Lotérias <verified-sender@example.com>
