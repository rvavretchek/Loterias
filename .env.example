DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0
# EMAIL_BACKEND nao e setado aqui de proposito: settings/base.py calcula o default sozinho
# (console ate BREVO_SMTP_KEY abaixo ganhar um valor real, SMTP depois disso) -- setar
# EMAIL_BACKEND aqui prende esse default no console pra sempre, mesmo com credencial Brevo real
# preenchida (bug real, achado numa retrospectiva em 2026-09-27: o .env.example ainda tinha essa
# linha fixa, reintroduzindo exatamente o problema que a logica de auto-deteccao corrigiu).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Lotérias <noreply@loterias.com>
OPERATOR_ALERT_EMAIL=boss@example.com
SITE_URL=http://www.loterias.internal
PASSWORD_PEPPER=change-me-in-production
# Brevo (SMTP relay) -- pegue o login e a chave SMTP em app.brevo.com > SMTP & API > SMTP.
# BREVO_FROM_EMAIL precisa ser um remetente verificado na conta Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_TLS=True
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=Lotérias <verified-sender@example.com>
